# ========================================================
# TrustVault - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit real secrets or production credentials!
# ========================================================

# --- FRONTEND (Firebase Cloud Integration) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_API_URL=http://localhost:8000

# --- BACKEND (Optional FastAPI / Enterprise Microservice) ---
SECRET_KEY=generate_with_openssl_rand_hex_64
SESSION_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173,https://your-domain.web.app
ENVIRONMENT=development
API_PORT=8000

# --- DATABASE (MySQL / SQLite) ---
USE_SQLITE=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=trustvault
MYSQL_USER=trustvault
MYSQL_PASSWORD=your_secure_db_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# --- S3 / MINIO COMPATIBLE STORAGE ---
STORAGE_TYPE=auto
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=trustvault-documents
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_secure_minio_password
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile & public keys
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Organizations & Memberships
    match /organizations/{orgId} {
      allow read, write: if request.auth != null;
    }
    match /org_memberships/{membershipId} {
      allow read, write: if request.auth != null;
    }
    // Documents & Envelopes
    match /documents/{docId} {
      allow read, write: if request.auth != null;
    }
    match /key_envelopes/{envId} {
      allow read, write: if request.auth != null;
    }
    match /shares/{shareId} {
      allow read, write: if request.auth != null;
    }
    // Immutable Audit Trail - only create, never update or delete
    match /audit_events/{eventId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /audit_chains/{orgId} {
      allow read, write: if request.auth != null;
    }
    // Security Alerts
    match /security_alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
  }
}
